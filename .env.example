POSTGRES_DB=agromatch
# memory: seeded in-process repositories, no PostgreSQL/Docker. Resets on restart.
REPOSITORY_MODE=prisma
POSTGRES_USER=agromatch
POSTGRES_PORT=5432
DATABASE_URL="postgresql://agromatch@localhost:5432/agromatch?schema=public"

# LLM (packages/ai). AI_MODE=fake no necesita ANTHROPIC_API_KEY.
AI_MODE=live
ANTHROPIC_API_KEY=

# Frontend: activa los mocks de MSW en vez de pegarle a :3333.
VITE_MOCKS=false

# Trabajar contra Railway en vez de la Postgres local de docker-compose:
# copiá `.env.railway.example` a `.env.railway` con la URL pública de Railway
# y usá los scripts "*:railway" de package.json (db:deploy:railway,
# db:seed:railway, db:studio:railway, dev:railway). Este `.env` no cambia —
# los dos entornos conviven, elegís cuál usar por el script que corrés.
