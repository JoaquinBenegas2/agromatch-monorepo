{
  "name": "@org/shared-types",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@org/source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./fixtures": {
      "@org/source": "./fixtures/index.ts",
      "types": "./dist/fixtures/index.d.ts",
      "import": "./dist/fixtures/index.js",
      "default": "./dist/fixtures/index.js"
    },
    "./fixtures/*": "./fixtures/*",
    "./testing": {
      "@org/source": "./testing/fakes.ts",
      "types": "./dist/testing/fakes.d.ts",
      "import": "./dist/testing/fakes.js",
      "default": "./dist/testing/fakes.js"
    }
  },
  "dependencies": {
    "tslib": "^2.3.0",
    "zod": "^4.6.2"
  }
}
