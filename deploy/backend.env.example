# AgroMatch backend en VM06. deploy-vm06.ps1 copia esta plantilla a \\vm06\shared\hackaton\backend\.env
# SOLO si todavia no existe (nunca pisa una key ya cargada). actualizar-vm06.ps1 la copia a
# C:\apps\hackaton\backend\.env y el servicio la lee al arrancar (dotenv).
# Despues de cambiarla: volver a correr actualizar-vm06.ps1.
# (PORT no va aca: lo fija el script en el servicio para que coincida con el web.config.)
#
# ESTE archivo es LA configuracion del deploy: no hay dotenv-cli ni .env.railway para la VM.
# Lo que se configura aca (Anthropic, base de datos, modo) es lo que corre en produccion.

# Pega tu key de Anthropic aca (sin comillas):
ANTHROPIC_API_KEY=

# Claude en vivo (fake = respuestas fijas, sin red).
AI_MODE=live

# Modo de repositorios:
#   memory -> sin base de datos, fixtures en memoria, se pierde al reiniciar
#   prisma -> Postgres via DATABASE_URL. deploy-vm06.ps1 aplica en cada deploy, desde la
#             maquina dev, `prisma migrate deploy` (solo pendientes, nunca resetea) y el seed
#             idempotente. Los datos que cargue la gente NO se tocan entre deploys.
REPOSITORY_MODE=prisma

# Railway: usar la URL PUBLICA (Postgres -> Connect -> Public Network), con host
# *.proxy.rlwy.net y su puerto. La *.railway.internal NO sirve: solo resuelve dentro de Railway.
DATABASE_URL=postgresql://postgres:<password>@<host>.proxy.rlwy.net:<puerto>/railway
