{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node", "multer"],
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ],
  "references": [
    {
      "path": "../../packages/shared-types/tsconfig.lib.json"
    },
    {
      "path": "../../packages/genetics-core/tsconfig.lib.json"
    },
    {
      "path": "../../packages/matching-core/tsconfig.lib.json"
    },
    {
      "path": "../../packages/ai/tsconfig.lib.json"
    }
  ]
}
