# Solo hace falta esta variable acá: todo lo demás (AI_MODE, ANTHROPIC_API_KEY,
# VITE_MOCKS) lo sigue tomando de `.env` — ver la nota de "Trabajar contra
# Railway" en `.env.example`.
#
# Copiá este archivo a `.env.railway` (gitignored) y pegá la URL PÚBLICA de
# Railway (Postgres → tab "Connect" → "Public Network", no la
# `*.railway.internal`, esa solo funciona entre servicios de Railway).
DATABASE_URL="postgresql://postgres:<password>@<host>.proxy.rlwy.net:<port>/railway?schema=public"
